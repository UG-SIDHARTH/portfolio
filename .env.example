# Portfolio Backend Security Environment Configuration

# Server Port (Default: 3500)
PORT=3500

# Production Environment Flag (production / development)
NODE_ENV=production

# Production Allowed CORS Origin
ALLOWED_ORIGIN=https://ugsidharth.in

# AES-256 Master Encryption Key (32-byte secret passphrase or 64-char hex string)
DATA_ENCRYPTION_KEY=replace_with_a_secure_random_64_character_hex_secret

# Admin API Key for accessing /api/admin endpoints
ADMIN_SECRET_KEY=replace_with_a_secure_admin_api_key
